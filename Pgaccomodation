CREATE TABLE owner (
    owner_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(100),
    email VARCHAR(100),
    mobile VARCHAR(15),
    age INT
);
CREATE TABLE tenant (
    tenant_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(100),
    email VARCHAR(100),
    mobile VARCHAR(15),
    age INT
);
CREATE TABLE city (
    city_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    city_name VARCHAR(100)
);

CREATE TABLE locality (
    locality_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    locality_name VARCHAR(100),
    city_id BIGINT,
    FOREIGN KEY (city_id) REFERENCES city(city_id)
);
CREATE TABLE pg_place (
    pg_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    pg_name VARCHAR(100),
    registration_no VARCHAR(50),
    built_up_area DOUBLE,
    rent DOUBLE,
    available BOOLEAN,
    owner_id BIGINT,
    city_id BIGINT,
    locality_id BIGINT,
    FOREIGN KEY (owner_id) REFERENCES owner(owner_id),
    FOREIGN KEY (city_id) REFERENCES city(city_id),
    FOREIGN KEY (locality_id) REFERENCES locality(locality_id)
);



