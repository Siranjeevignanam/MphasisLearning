-- To fetch all details --
SELECT 
    c.customerId,
    c.customer_Name,c.customer_Address,c.phone_No,c.email,

m.meterId,m.installation_date,m.last_reading_date,

    e.usageId,e.reading_date,e.usage_units,

    b.billId,b.bill_date,b.amount_due,b.paid,b.due_date,

    p.paymentId,
    p.payment_date,
    p.amount_paid

FROM customer c
JOIN meter m ON c.customerId = m.customerId JOIN electricity_usage e ON m.meterId = e.meterId
JOIN bill b ON m.meterId = b.meterId JOIN payment p ON b.billId = p.billId;


-- To get electricity usage over 200 --
SELECT 
    meterId,
    SUM(usage_units) AS total_usage FROM electricity_usage 
GROUP BY meterId
having total_usage > 200;


-- Unpaid customers in descnding order based on amount --
SELECT 
    c.customerId,
    c.customer_Name,
    SUM(b.amount_due) AS total_unpaid_amount
FROM customer c
JOIN meter m ON c.customerId = m.customerId
join bill b ON m.meterId = b.meterId
WHERE b.paid = 0
GROUP BY c.customerId, c.customer_Name
ORDER BY total_unpaid_amount DESC;

--
SELECT 
    b.billId,
    b.bill_date,
    b.paid,
    CASE 
	WHEN b.paid = 1 THEN 'PAID'
ELSE 'UNPAID'
    END AS payment_status
FROM bill b
ORDER BY b.bill_date;

-- To get customer details who have installed meter after 2023-12-31 --
SELECT 
    c.customerId,c.customer_Name,c.customer_Address,m.meterId,m.installation_date
FROM customer c
JOIN meter m ON c.customerId = m.customerId
WHERE m.installation_date > '2023-12-31';


-- To show meters with last reading date and total usage in descending order of usage --
SELECT 
    m.meterId,m.last_reading_date,
    SUM(e.usage_units) AS total_usage
FROM meter m
JOIN electricity_usage e ON m.meterId = e.meterId
GROUP BY m.meterId
ORDER BY total_usage DESC;
